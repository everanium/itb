+	xor16((*[16]byte)(dst[32:48]), (*[16]byte)(a[32:48]), (*[16]byte)(b[32:48]))
+	xor16((*[16]byte)(dst[48:64]), (*[16]byte)(a[48:64]), (*[16]byte)(b[48:64]))
