 // XorBlock4 computes dst = a XOR b for Block4.
 func XorBlock4(dst, a, b *Block4) {
-	aPtr := (*[8]uint64)(unsafe.Pointer(a))
-	bPtr := (*[8]uint64)(unsafe.Pointer(b))
