-	dstPtr[0] = aPtr[0] ^ bPtr[0]
-	dstPtr[1] = aPtr[1] ^ bPtr[1]
-	dstPtr[2] = aPtr[2] ^ bPtr[2]
-	dstPtr[3] = aPtr[3] ^ bPtr[3]
-	dstPtr[4] = aPtr[4] ^ bPtr[4]
-	dstPtr[5] = aPtr[5] ^ bPtr[5]
-	dstPtr[6] = aPtr[6] ^ bPtr[6]
