# Main exclusions

/.*.md

# Test and build binaries
/itb
/itb.test
/cshared
**/eitb/eitb
# Bindings whose eitb entry-point is a committed shell launcher
# (not a compiled binary) — re-include those so git tracks them.
!bindings/clojure/eitb/eitb
!bindings/crystal/eitb/eitb
!bindings/dart/eitb/eitb
!bindings/elixir/eitb/eitb
!bindings/gleam/eitb/eitb
!bindings/groovy/eitb/eitb
!bindings/haskell/eitb/eitb
!bindings/java/eitb/eitb
!bindings/julia/eitb/eitb
!bindings/kotlin/eitb/eitb
!bindings/lfe/eitb/eitb
!bindings/lua/eitb/eitb
!bindings/nim/eitb/eitb
!bindings/nodejs/eitb/eitb
!bindings/ocaml/eitb/eitb
!bindings/r/eitb/eitb
!bindings/ruby/eitb/eitb
!bindings/scala/eitb/eitb
/eitb
/tools/eitb/eitb
# Parity helper compiled binaries (built by scripts/parity/cross-build-parity.sh)
/tools/parity/parity-cgo
/tools/parity/parity-nocgo
*.test

# CPU/memory profiles
*.prof
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Red team attack sandbox
tmp/
__pycache__/
*.pyc

# Shared library / FFI build artefacts (cmd/cshared)
/dist/
libitb.so
libitb.dll
libitb.dylib
libitb.h
libitb.a
cmd/cshared/libitb.*
cmd/cshared/itb.h
cmd/cshared/cshared
cmd/cshared/cshared.h
bindings/rust/target
bindings/rust/Cargo.lock

# Python pytest runtime cache
.pytest_cache/

# Rust formatter backup files
*.rs.bk

# Python build artefacts (in case anyone runs python -m build / pip install -e)
**/*.egg-info/
bindings/python/build/
bindings/python/dist/

# Fortran cache
*.mod

# OS
.DS_Store
Thumbs.db
