<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Everanium.Itb3.VisualBasic.Bench</RootNamespace>
    <AssemblyName>Everanium.LibItb3.VisualBasic.Bench</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Everanium.LibItb3.VisualBasic\Everanium.LibItb3.VisualBasic.vbproj" />
  </ItemGroup>

</Project>
