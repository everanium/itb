<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Everanium.Itb.VisualBasic</RootNamespace>
    <AssemblyName>EveraniumItb.VisualBasic</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <PackageId>EveraniumItb.VisualBasic</PackageId>
    <Version>0.3.5</Version>
    <Authors>everanium</Authors>
    <Description>VB.NET binding for ITB (information-theoretic barrier) cipher — thin proxy over the sibling C# binding's Triple Pipeline surface via CLR bytecode interop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cryptography;cipher;ouroboros;vbnet;itb</PackageTags>
    <RepositoryUrl>https://github.com/everanium/itb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup Label="Assembly visibility for tests">
    <InternalsVisibleTo Include="EveraniumItb.VisualBasic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\csharp\Itb\Itb.csproj" />
  </ItemGroup>

</Project>
