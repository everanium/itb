{;; Thin proxy over the sibling Java binding: the library classpath is
 ;; the Java binding jar (JVM bytecode interop, no FFI layer of its
 ;; own). Build ../java first (build.sh chains it) so the jar exists
 ;; when the classpath is computed.
 :paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        everanium/libitb3-java {:local/root "../java/build/libs/libitb3-java-0.5.1.jar"}}
 :aliases
 {;; clojure.test suite: clojure -M:test -m io.github.everanium.itb3.clojure.test-runner
  :test {:extra-paths ["test"]}
  ;; micro-benchmarks: clojure -M:bench -m io.github.everanium.itb3.clojure.bench-message
  :bench {:extra-paths ["bench"]}
  ;; eitb CLI script: clojure -M:eitb eitb/main.clj <args>
  :eitb {}
  ;; loop stress harness: clojure -M:loop -m io.github.everanium.itb3.clojure.loop.main
  :loop {:extra-paths ["loop"]}}}
