{
    "name": "everanium/itb",
    "description": "PHP binding for libitb (ITB Triple Pipeline) — FFI relay over the shared library",
    "type": "library",
    "license": "MIT",
    "keywords": ["itb", "encryption", "ffi", "cipher"],
    "require": {
        "php": ">=7.4",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10 || ^11 || ^12"
    },
    "autoload": {
        "psr-4": {
            "Everanium\\Itb\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap autoload.php tests"
    }
}
