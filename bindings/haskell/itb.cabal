cabal-version:      3.0
name:               itb
version:            0.3.0
synopsis:           Haskell binding for the ITB Triple Pipeline (libitb C ABI)
description:
    Thin proxy over the libitb shared library's @ITB_Triple_*@ surface
    (built from @cmd/cshared@ in the ITB repository). Every hash-name /
    MAC-name / cipher-name / profile-name is an opaque string passed
    through to Go for validation; the binding carries no ITB
    construction logic of its own.
license:            MIT
author:             ITB contributors
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        ITB
        ITB.Errors
        ITB.FFI
        ITB.Opts
        ITB.Pipeline
        ITB.Stream
    build-depends:
        base       >=4.14 && <5,
        bytestring >=0.10
    -- The link-time search path for libitb.so is injected by build.sh
    -- through a generated cabal.project.local (absolute extra-lib-dirs
    -- plus an rpath); ghc-pkg rejects relative extra-lib-dirs at
    -- registration time, so no path is hard-coded here. Run ./build.sh
    -- (or write an equivalent cabal.project.local) before `cabal build`.
    extra-libraries:  itb
    default-language: Haskell2010

test-suite tests
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base,
        bytestring,
        hspec >=2.7,
        itb
    ghc-options:      -threaded
    default-language: Haskell2010

benchmark itb-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Bench.hs
    build-depends:
        base,
        bytestring,
        itb
    ghc-options:      -threaded -O2
    default-language: Haskell2010

executable itb-eitb
    import:           warnings
    hs-source-dirs:   eitb
    main-is:          Main.hs
    build-depends:
        base,
        bytestring,
        directory,
        filepath,
        itb
    ghc-options:      -threaded
    default-language: Haskell2010
