<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Everanium.Itb3.FSharp</RootNamespace>
    <AssemblyName>Everanium.LibItb3.FSharp</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <PackageId>Everanium.LibItb3.FSharp</PackageId>
    <Version>0.5.1</Version>
    <Authors>Andrey Kuvshinov</Authors>
    <Description>ITB Symmetric Cipher Construction with Ambiguity-Based Security - F#</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>cryptography;encryption;cipher;symmetric;aead</PackageTags>
    <RepositoryUrl>https://github.com/everanium/itb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/everanium/itb</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Andrey Kuvshinov</Copyright>
  </PropertyGroup>

  <ItemGroup Label="Package content">
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Status.fs" />
    <Compile Include="Error.fs" />
    <Compile Include="Opts.fs" />
    <Compile Include="Pipeline.fs" />
    <Compile Include="Stream.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\csharp\Everanium.LibItb3\Everanium.LibItb3.csproj" />
  </ItemGroup>

</Project>
